PORT=3001
HOST=127.0.0.1
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_USER=admin
AUTH_PASS=secret
AUDIO_DIR=E:/Audio
FFMPEG_PATH=C:/Program Files (x86)/ffmpeg-master-latest-win64-gpl-shared/bin/ffmpeg.exe

# Docker: see .env.docker.example and docker-compose.yml
# Inside the container AUDIO_DIR is /mnt/audio and FFMPEG_PATH is ffmpeg
