# Copy to .env next to docker-compose.yml, or export before `docker compose up`.

PUBLISH_PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_USER=admin
AUTH_PASS=secret

# Host folder with your MP3s (Windows example: M:/_finished/Audio or E:/Audio)
# Gets mounted into the container at /mnt/audio (see docker-compose.yml)
AUDIO_HOST_PATH=./audio
