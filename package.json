{
  "name": "mp3-webeditor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "kill": "node scripts/kill-ports.mjs",
    "dev": "node scripts/kill-ports.mjs && concurrently -k -n api,web -c green,cyan \"npm run server\" \"npm run client\"",
    "restart": "npm run dev",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "vite": "^5.4.11"
  },
  "overrides": {
    "tar": "^7.5.19",
    "brace-expansion": "^2.1.2",
    "picomatch": "^4.0.4",
    "sigstore": "^4.1.1"
  }
}
